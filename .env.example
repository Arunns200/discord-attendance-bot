DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Required to lock attendance logs to one channel (your shift log).
# Right-click the channel in Discord → Copy Channel ID (Developer Mode must be on).
DISCORD_SHIFT_LOG_CHANNEL_ID=your_shift_log_channel_id_here

# Optional overrides
# DATABASE_PATH=data/attendance.db
# LOG_LEVEL=INFO

# Railway sets RAILWAY_ENVIRONMENT automatically.
# On Railway with a volume mounted at /app/data, the default DB path is:
# /app/data/attendance.db
